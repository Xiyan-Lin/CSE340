<div class="container">
  <h1 class="title">Add Inventory</h1>

  <%- messages() %>

  <% if (errors) { %>
  <ul class="error-box">
    <% errors.array().forEach(error => { %>
      <li><%= error.msg %></li>
    <% }) %>
  </ul>
  <% } %>

  <div class="card">
    <form action="/inv/add-inventory" method="post" class="form" enctype="multipart/form-data">

      <label>Make</label>
      <input name="inv_make" required value="<%= locals.inv_make || '' %>">

      <label>Model</label>
      <input name="inv_model" required value="<%= locals.inv_model || '' %>">

      <label>Year</label>
      <input name="inv_year" type="number" required value="<%= locals.inv_year || '' %>">

      <label>Desciption</label>
      <input name="inv_description" required value="<%= locals.inv_description || '' %>">

      <label>Price</label>
      <input name="inv_price" required value="<%= locals.inv_price || '' %>">

      <label>Miles</label>
      <input name="inv_miles" required value="<%= locals.inv_miles || '' %>">

      <label>Color</label>
      <input name="inv_color" required value="<%= locals.inv_color || '' %>">

      <label>Classification</label>
      <div class="select-box">
        <%- classificationList %>
      </div>

      <label>Upload Image</label>
      <input type="file" name="inv_image" accept="image/*" required>

      <button type="submit" class="btn">Add Inventory</button>

    </form>
  </div>
</div>