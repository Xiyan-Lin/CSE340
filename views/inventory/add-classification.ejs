<div class="container">
  <h1 class="title">Add Classification</h1>

  <%- messages() %>

  <% if (errors) { %>
  <ul class="error-box">
    <% errors.array().forEach(error => { %>
      <li><%= error.msg %></li>
    <% }) %>
  </ul>
  <% } %>

  <div class="card">
    <form action="/inv/add-classification" method="post" class="form">

      <label>Classification Name</label>
      <input 
        type="text" 
        name="classification_name" 
        required 
        pattern="^[A-Za-z0-9]+$"
        placeholder="Enter classification (no spaces)"
      >

      <button type="submit" class="btn">Add Classification</button>
    </form>
  </div>
</div>