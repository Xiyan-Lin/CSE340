<h1><%= title %></h1>

<div class="detail-container">
  <%- detailHTML %>
</div>

<h2 class="review-title">Customer Reviews</h2>

<div class="review-section">

  <% if (reviews.length === 0) { %>
    <p class="no-review">No reviews yet. Be the first to review!</p>
  <% } %>

  <% reviews.forEach(r => { %>
    <div class="review-card">
      
      <div class="review-header">
        <span class="review-name"><%= r.reviewer_name %></span>
        <span class="review-stars">
          <% for(let i = 0; i < r.rating; i++) { %> ⭐ <% } %>
        </span>
      </div>

      <p class="review-comment"><%= r.comment %></p>

      <div class="review-footer">
        <small><%= new Date(r.created_at).toLocaleDateString() %></small>
      </div>

    </div>
  <% }) %>

</div>

<hr class="review-divider">

<h3 class="review-form-title">Write a Review</h3>

<form action="/inv/review" method="post" class="review-form">
  <input type="hidden" name="inv_id" value="<%= inv_id %>">

  <label>Name</label>
  <input name="reviewer_name" required>

  <label>Rating</label>
  <select name="rating" required>
    <option value="5" selected>⭐⭐⭐⭐⭐ (5)</option>
    <option value="4">⭐⭐⭐⭐ (4)</option>
    <option value="3">⭐⭐⭐ (3)</option>
    <option value="2">⭐⭐ (2)</option>
    <option value="1">⭐ (1)</option>
  </select>

  <label>Comment</label>
  <textarea name="comment" rows="4" required></textarea>

  <button type="submit">Submit Review</button>
</form>